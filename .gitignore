# Gas City
.gc/
**/.beads/*
!**/.beads/identity.toml
hooks/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
**/.beads/proxieddb/
# bd's scope gate, written next to the store rather than inside it
**/*.gate.lock

# gc projects its skills into the city root as symlinks into ~/.gc/cache.
# Generated + machine-local, so never versioned. Scoped to skills/ so a
# hand-written .claude/settings.json or CLAUDE.md can still be tracked.
**/.claude/skills/

# Dolt backups (binary, local recovery only — never versioned in git)
.dolt-backup/

# Stray HOME-relative writes: gc sometimes spawns a process with HOME unset or
# pointing at the city dir, so bd and python drop their dotfiles here.
gascity/.config/
gascity/Library/
gascity/~/

# Derived state: rewritten by the snapshot order every 15 minutes, and
# rebuildable from the agent/* branches. It now lives under XDG state; this
# keeps an older checkout from re-tracking it.
agent-branches.tsv
