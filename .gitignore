# Gas City
.gc/
**/.beads/*
!**/.beads/identity.toml
hooks/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
**/.beads/proxieddb/

# gc projects its skills into the city root as symlinks into ~/.gc/cache.
# Generated + machine-local, so never versioned. Scoped to skills/ so a
# hand-written .claude/settings.json or CLAUDE.md can still be tracked.
**/.claude/skills/

# Dolt backups (binary, local recovery only — never versioned in git)
.dolt-backup/
